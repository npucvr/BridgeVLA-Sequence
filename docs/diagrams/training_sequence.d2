shape: sequence_diagram

replay: "回放采样器"
agent: "BridgeVLA 智能体"
mvt: "两阶段 MVT"
vlm: "PaliGemma"
heads: "动作预测头"
optim: "优化器"

replay -> agent: "随机单步批次，timesteps = 1"
agent -> agent: "预处理点云并执行 SE(3) 数据增强"
agent -> mvt: "RGB、点云、任务语言和训练用真实路点"

stage_one: "阶段 1" {
  mvt -> vlm: "三个全局视图 + 任务语言"
  vlm -> heads: "图像 token"
  heads -> mvt: "粗粒度平移热图"
}

mvt -> mvt: "以带扰动的真实路点重定位场景"

stage_two: "阶段 2" {
  mvt -> vlm: "三个局部视图 + 任务语言"
  vlm -> heads: "图像 token"
}

heads -> agent: "平移、旋转、夹爪和碰撞的未归一化分数"
agent -> optim: "交叉熵损失；backward() + step()"
