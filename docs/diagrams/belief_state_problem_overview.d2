style.fill: transparent
style.font-size: 16

direction: right

state: "真实任务状态\ns_t（不可直接观测）"
obs: "当前传感器观测\no_t（含自然噪声）"
encoder: "MVT + PaliGemma\n视觉 token z_t"
history: "历史 token\nz_1:t-1"
action_prev: "已执行动作\nu_1:t-1"
belief: "任务相关 belief state\nb_t"
language: "任务语言"
policy: "BridgeVLA 策略\n当前动作预测"
action: "当前动作\nu_t"
env: "环境执行\n产生下一观测"

state -> obs: "生成观测"
obs -> encoder
encoder -> belief: "当前 token"
history -> belief
action_prev -> belief
belief -> policy
language -> policy
policy -> action
action -> env
env -> obs: "下一时刻"
env -> history: "累积历史"

state.style.stroke-dash: 4
state.style.opacity: 0.75
